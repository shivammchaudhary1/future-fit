{
  "name": "future-fit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:bootstrap": "pnpm --filter @future-fit/api db:bootstrap",
    "db:verify": "pnpm --filter @future-fit/api db:verify",
    "build:all": "turbo build",
    "start:built": "node scripts/check-built.mjs && pnpm -r --parallel --filter @future-fit/api --filter @future-fit/worker --filter @future-fit/web run start",
    "build:start": "pnpm build:all && pnpm start:built",
    "check:all": "pnpm db:verify && pnpm lint && pnpm typecheck && pnpm build:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-next": "^15.5.2",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
